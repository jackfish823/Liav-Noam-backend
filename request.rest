### Users

### Create a new user
POST http://localhost:3000/user
Content-Type: application/json

{
  "username": "johndoe",
  "email": "john@example.com",
  "password": "password123"
}

### Get all users
GET http://localhost:3000/user

### Get user by ID
GET http://localhost:3000/user/USER_ID

### Update a user
PUT http://localhost:3000/user/USER_ID
Content-Type: application/json

{
  "username": "johndoe_updated",
  "email": "john_updated@example.com",
  "password": "newpassword456"
}

### Delete a user
DELETE http://localhost:3000/user/USER_ID


### Posts

### Get all posts
GET http://localhost:3000/post

### Get posts by author (User ID)
GET http://localhost:3000/post?author=USER_ID

### Get post by ID
GET http://localhost:3000/post/694e5d377193f8baffa22040

### Create a new post
POST http://localhost:3000/post
Content-Type: application/json

{
  "message": "Hello, world!",
  "author": "694e5c3e7193f8baffa2203e"
}

### Update a post
PUT http://localhost:3000/post/POST_ID
Content-Type: application/json

{
  "message": "This is an updated message.",
  "author": "USER_ID"
}

### Delete a post
DELETE http://localhost:3000/post/POST_ID


### Comments

### Get all comments
GET http://localhost:3000/comment

### Get comment by id
GET http://localhost:3000/comment/COMMENT_ID

### Get comments by post ID
GET http://localhost:3000/comment?postId=POST_ID

### Create a new comment
POST http://localhost:3000/comment
Content-Type: application/json

{
  "body": "This is a comment.",
  "postId": "694e5d377193f8baffa22040",
  "author": "694e5c3e7193f8baffa2203e"
}

### Update a comment
PUT http://localhost:3000/comment/COMMENT_ID
Content-Type: application/json

{
  "body": "This is an updated comment."
}

### Delete a comment
DELETE http://localhost:3000/comment/COMMENT_ID
