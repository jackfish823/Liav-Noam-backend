### Users

### Create a new user
POST http://localhost:3000/user
Content-Type: application/json

{
  "username": "johndoe",
  "email": "john@example.com",
  "password": "password123"
}

### Get all users
GET http://localhost:3000/user

### Get user by ID
GET http://localhost:3000/user/USER_ID

### Update a user
PUT http://localhost:3000/user/USER_ID
Content-Type: application/json

{
  "username": "johndoe_updated",
  "email": "john_updated@example.com"
}

### Update user and remove profile image
PUT http://localhost:3000/user/USER_ID
Content-Type: application/json

{
  "username": "johndoe_updated",
  "profileImage": null
}

### Delete a user
DELETE http://localhost:3000/user/USER_ID


### Posts

### Get all posts
GET http://localhost:3000/post

### Get posts by author (User ID)
GET http://localhost:3000/post?author=USER_ID

### Get post by ID
GET http://localhost:3000/post/694e5d377193f8baffa22040

### Create a new post with image ID (requires authentication)
POST http://localhost:3000/post
Authorization: Bearer YOUR_ACCESS_TOKEN
Content-Type: application/json

{
  "message": "Hello, world!",
  "image": "IMAGE_ID_HERE"
}

### Create a new post without image (requires authentication)
POST http://localhost:3000/post
Authorization: Bearer YOUR_ACCESS_TOKEN
Content-Type: application/json

{
  "message": "Hello, world!"
}

### Update a post with image ID (requires authentication)
PUT http://localhost:3000/post/POST_ID
Authorization: Bearer YOUR_ACCESS_TOKEN
Content-Type: application/json

{
  "message": "This is an updated message.",
  "image": "IMAGE_ID_HERE"
}

### Update a post and remove image (requires authentication)
PUT http://localhost:3000/post/POST_ID
Authorization: Bearer YOUR_ACCESS_TOKEN
Content-Type: application/json

{
  "message": "This is an updated message.",
  "image": null
}

### Update only post message, keep existing image (requires authentication)
PUT http://localhost:3000/post/POST_ID
Authorization: Bearer YOUR_ACCESS_TOKEN
Content-Type: application/json

{
  "message": "This is an updated message."
}

### Like a post (requires authentication)
POST http://localhost:3000/post/POST_ID/like
Authorization: Bearer YOUR_ACCESS_TOKEN

### Remove like from a post (requires authentication)
DELETE http://localhost:3000/post/POST_ID/like
Authorization: Bearer YOUR_ACCESS_TOKEN

### Delete a post
DELETE http://localhost:3000/post/POST_ID
Authorization: Bearer YOUR_ACCESS_TOKEN

### Comments

### Get all comments
GET http://localhost:3000/comment

### Get comment by id
GET http://localhost:3000/comment/COMMENT_ID

### Get comments by post ID
GET http://localhost:3000/comment?postId=POST_ID

### Create a new comment
POST http://localhost:3000/comment
Content-Type: application/json

{
  "body": "This is a comment.",
  "postId": "694e5d377193f8baffa22040",
  "author": "694e5c3e7193f8baffa2203e"
}

### Update a comment
PUT http://localhost:3000/comment/COMMENT_ID
Content-Type: application/json

{
  "body": "This is an updated comment."
}

### Upvote or downvote a comment (requires authentication)
POST http://localhost:3000/comment/COMMENT_ID/vote
Authorization: Bearer YOUR_ACCESS_TOKEN
Content-Type: application/json

{
  "value": 1
}

### Remove vote from a comment (requires authentication)
DELETE http://localhost:3000/comment/COMMENT_ID/vote
Authorization: Bearer YOUR_ACCESS_TOKEN

### Delete a comment
DELETE http://localhost:3000/comment/COMMENT_ID


### Authentication

### Register (create user)
POST http://localhost:3000/user
Content-Type: application/json

{
  "username": "testuser",
  "email": "test@example.com",
  "password": "password123"
}

### Login
POST http://localhost:3000/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "password123"
}

### Google OAuth Login
POST http://localhost:3000/auth/google
Content-Type: application/json

{
  "credential": "YOUR_GOOGLE_ACCESS_TOKEN"
}

### Refresh token
POST http://localhost:3000/auth/refresh
Content-Type: application/json

{
  "refreshToken": "YOUR_REFRESH_TOKEN"
}

### Logout
POST http://localhost:3000/auth/logout
Content-Type: application/json

{
  "refreshToken": "YOUR_REFRESH_TOKEN"
}


### Images

### Get image by ID
GET http://localhost:3000/image/IMAGE_ID

### Upload an image (requires authentication)
POST http://localhost:3000/image
Authorization: Bearer YOUR_ACCESS_TOKEN
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="image"; filename="photo.jpg"
Content-Type: image/jpeg

< ./path/to/your/image.jpg
------WebKitFormBoundary7MA4YWxkTrZu0gW--

### Delete an image (requires authentication)
DELETE http://localhost:3000/image/IMAGE_ID
Authorization: Bearer YOUR_ACCESS_TOKEN
