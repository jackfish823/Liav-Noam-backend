### Get all posts
GET http://localhost:3000/post

### Get posts by sender
GET http://localhost:3000/post?sender=John%20Doe

### Get post by ID
GET http://localhost:3000/post/POST_ID

### Create a new post
POST http://localhost:3000/post
Content-Type: application/json

{
  "message": "Hello, world!",
  "sender": "John Doe"
}

### Update a post
PUT http://localhost:3000/post/POST_ID
Content-Type: application/json

{
  "message": "This is an updated message.",
  "sender": "John Doe"
}

### Delete a post
DELETE http://localhost:3000/post/POST_ID

### Get all comments
GET http://localhost:3000/comments

### Get comments by post ID
GET http://localhost:3000/comments?postId=POST_ID

### Create a new comment
POST http://localhost:3000/comments
Content-Type: application/json

{
  "body": "This is a comment.",
  "postId": "POST_ID",
  "author": "Jane Doe"
}

### Update a comment
PUT http://localhost:3000/comments/COMMENT_ID
Content-Type: application/json

{
  "body": "This is an updated comment."
}

### Delete a comment
DELETE http://localhost:3000/comments/COMMENT_ID